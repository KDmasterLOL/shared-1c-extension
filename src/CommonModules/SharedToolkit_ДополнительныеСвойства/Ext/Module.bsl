#Область ПрограммныйИнтерфейс

// Источники HyperSnips: ПолучитьОбъектПоЗначениюСвойства,
// УстановитьСвойство, ЗаполнитьДопСвойства.

// Возвращает таблицу дополнительных свойств в формате, совместимом с
// УправлениеСвойствами.ЗаписатьСвойстваУОбъекта().
//
// Параметры:
//  Источник - не заполнено - возвращается пустая таблица.
//           - ЛюбаяСсылка - возвращаются текущие дополнительные свойства владельца.
//           - Объект информационной базы - используются свойства ссылки объекта.
//           - Структура, ФиксированнаяСтруктура - ключ является именем свойства,
//             значение ключа становится значением свойства.
//           - Соответствие, ФиксированноеСоответствие - ключом может быть имя свойства
//             или ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения.
//           - ТаблицаЗначений - таблица с колонками Свойство и Значение.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Свойство - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения.
//   * Значение - Произвольный.
Функция ПолучитьТаблицуСвойств(Источник = Неопределено) Экспорт
	ТаблицаСвойств = SharedToolkit_Коллекции.СоздатьТаблицуЗначений("Свойство,Значение");

	Если НЕ ЗначениеЗаполнено(Источник) Тогда Возврат ТаблицаСвойств; КонецЕсли;

	ТипИсточника = ТипЗнч(Источник);
	Если SharedToolkit_Значения.ЗначениеОдногоИзТипов(
		Источник,
		"Структура,ФиксированнаяСтруктура,Соответствие,ФиксированноеСоответствие"
	) Тогда
		ПараметрыПреобразования = Новый Структура(
			"ИмяКолонкиКлюча,ИмяКолонкиЗнч",
			"Свойство",
			"Значение"
		);
		ТаблицаКлючейИЗначений = SharedToolkit_Коллекции.ПреобразоватьВ(
			Источник,
			Тип("ТаблицаЗначений"),
			ПараметрыПреобразования
		);
		Для Каждого СтрокаИсточника Из ТаблицаКлючейИЗначений Цикл
			ДобавитьСвойствоВТаблицу(ТаблицаСвойств, СтрокаИсточника.Свойство, СтрокаИсточника.Значение);
		КонецЦикла;
		Возврат ТаблицаСвойств;
	КонецЕсли;

	Если ТипИсточника = Тип("ТаблицаЗначений") Тогда
		Если Источник.Колонки.Найти("Свойство") = Неопределено
			ИЛИ Источник.Колонки.Найти("Значение") = Неопределено Тогда
			ВызватьИсключение "Таблица свойств должна содержать колонки Свойство и Значение";
		КонецЕсли;

		Для Каждого СтрокаИсточника Из Источник Цикл
			ДобавитьСвойствоВТаблицу(ТаблицаСвойств, СтрокаИсточника.Свойство, СтрокаИсточника.Значение);
		КонецЦикла;
		Возврат ТаблицаСвойств;
	КонецЕсли;

	ВладелецСвойств = Источник;
	Если НЕ ОбщегоНазначения.ЗначениеСсылочногоТипа(ВладелецСвойств) Тогда
		Если НЕ ЗначениеЗаполнено(Метаданные.НайтиПоТипу(ТипИсточника)) Тогда
			ВызватьИсключение СтрШаблон("Неподдерживаемый источник таблицы свойств: %1", ТипИсточника);
		КонецЕсли;
		ВладелецСвойств = Источник.Ссылка;
	КонецЕсли;

	Если НЕ ОбщегоНазначения.ЗначениеСсылочногоТипа(ВладелецСвойств) Тогда
		ВызватьИсключение СтрШаблон("Источник не является владельцем дополнительных свойств: %1", ТипИсточника);
	КонецЕсли;

	ОбъектыСоСвойствами = Новый Массив;
	ОбъектыСоСвойствами.Добавить(ВладелецСвойств);
	ЗначенияСвойств = УправлениеСвойствами.ЗначенияСвойств(ОбъектыСоСвойствами);

	Для Каждого СтрокаСвойства Из ЗначенияСвойств Цикл
		ДобавитьСвойствоВТаблицу(ТаблицаСвойств, СтрокаСвойства.Свойство, СтрокаСвойства.Значение);
	КонецЦикла;

	Возврат ТаблицаСвойств;
КонецФункции

Функция ПолучитьОбъектПоЗначениюСвойства(Значение, Свойство) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|ДополнительныеСведения.Объект КАК Объект
		|ИЗ
		|РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|ДополнительныеСведения.Значение = &Значение
		|И ДополнительныеСведения.Свойство = &Свойство";
	Запрос.УстановитьПараметр("Значение", Значение);
	Запрос.УстановитьПараметр("Свойство", Свойство);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Объект, Неопределено);
КонецФункции

Процедура УстановитьСвойство(Объект, Свойство, Значение) Экспорт
	Если НЕ ЗначениеЗаполнено(Объект) Тогда Возврат; КонецЕсли;

	НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Объект);
	НаборЗаписей.Отбор.Свойство.Установить(Свойство);
	НаборЗаписей.Прочитать();

	Если НЕ ЗначениеЗаполнено(НаборЗаписей) Тогда
		Запись = НаборЗаписей.Добавить();
		Запись.Объект = Объект;
		Запись.Свойство = Свойство;
	Иначе
		Запись = НаборЗаписей[0];
	КонецЕсли;

	Запись.Значение = Значение;
	НаборЗаписей.Записать();
КонецПроцедуры

Процедура ЗаписатьДополнительноеСвойство(Ссылка, Свойство, Значение) Экспорт
	ТаблицаСвойств = ПолучитьТаблицуСвойств();
	ДобавитьСвойствоВТаблицу(ТаблицаСвойств, Свойство, Значение);
	УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Ссылка, ТаблицаСвойств);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСвойствоВТаблицу(ТаблицаСвойств, Свойство, Значение)
	НоваяСтрока = ТаблицаСвойств.Добавить();
	НоваяСтрока.Свойство = ПолучитьСвойство(Свойство);
	НоваяСтрока.Значение = Значение;
КонецПроцедуры

Функция ПолучитьСвойство(Свойство)
	Если ТипЗнч(Свойство) = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения") Тогда Возврат Свойство; КонецЕсли;

	Если ТипЗнч(Свойство) = Тип("Строка") Тогда
		НайденноеСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", Свойство);
		Если НЕ ЗначениеЗаполнено(НайденноеСвойство) Тогда
			ВызватьИсключение СтрШаблон("Дополнительное свойство с именем '%1' не найдено", Свойство);
		КонецЕсли;
		Возврат НайденноеСвойство;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Неподдерживаемый идентификатор дополнительного свойства: %1", ТипЗнч(Свойство));
КонецФункции

#КонецОбласти
