#Область ПрограммныйИнтерфейс

// Источники HyperSnips: ПользовательВГруппеПользователей,
// ПользовательВГруппеДоступа.
// ТекущийПользователь остается сокращённым шаблоном кода: отдельная функция-обёртка
// вокруг ПараметрыСеанса.ТекущийПользователь не нужна.

// Проверяет, входит ли пользователь в указанную группу.
//
// Параметры:
//  ИмяГруппы - Строка - наименование группы.
//  ТипГруппы - Строка - "Пользователей" или "Доступа".
//  Пользователь - СправочникСсылка.Пользователи - проверяемый пользователь.
//      Если не указан, используется текущий пользователь сеанса.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь входит в группу.
Функция ПользовательВГруппе(ИмяГруппы, ТипГруппы, Пользователь = Неопределено) Экспорт
	Если ТипГруппы = "Пользователей" Тогда
		ИмяТаблицыГруппы = "Справочник.ГруппыПользователей.Состав";
	ИначеЕсли ТипГруппы = "Доступа" Тогда
		ИмяТаблицыГруппы = "Справочник.ГруппыДоступа.Пользователи";
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестный тип группы: %1", ТипГруппы);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Пользователь = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|СоставГруппы.Ссылка КАК Ссылка
		|ИЗ
		|{ТаблицаГруппы} КАК СоставГруппы
		|ГДЕ
		|	СоставГруппы.Пользователь = &Пользователь
		|	И СоставГруппы.Ссылка.Наименование = &ИмяГруппы",
		"{ТаблицаГруппы}",
		ИмяТаблицыГруппы
	);
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("ИмяГруппы", ИмяГруппы);

	ПредыдущийПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);

	Попытка
		ПользовательВходитВГруппу = НЕ Запрос.Выполнить().Пустой();
	Исключение
		УстановитьПривилегированныйРежим(ПредыдущийПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;

	УстановитьПривилегированныйРежим(ПредыдущийПривилегированныйРежим);
	Возврат ПользовательВходитВГруппу;
КонецФункции

#КонецОбласти
