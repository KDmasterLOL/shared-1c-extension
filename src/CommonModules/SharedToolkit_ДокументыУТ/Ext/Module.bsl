#Область ПрограммныйИнтерфейс

// Источники HyperSnips: Функция.СоздатьДокумент.УстановкаЦенНоменклатуры,
// МассоваяПометкаНаУдаление.
// Модуль изолирован как УТ-специфичный: он использует метаданные УТ/КА.

Функция СоздатьУстановкуЦенНоменклатуры(
	ТаблицаЦен,
	ВидЦены,
	Комментарий = "Создан программно") Экспорт

	Если НЕ ЗначениеЗаполнено(ВидЦены) Тогда
		ВызватьИсключение "Не задан вид цены для документа установки цен.";
	КонецЕсли;

	ДокументУстановкаЦен = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	ДокументУстановкаЦен.Дата = ТекущаяДатаСеанса();
	ДокументУстановкаЦен.Статус = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован;
	ДокументУстановкаЦен.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	ДокументУстановкаЦен.Комментарий = Комментарий;

	СтрокаВидыЦен = ДокументУстановкаЦен.ВидыЦен.Добавить();
	СтрокаВидыЦен.ВидЦены = ВидЦены;

	Для Каждого ДанныеЦены Из ТаблицаЦен Цикл
		Если НЕ ЗначениеЗаполнено(ДанныеЦены.Номенклатура) Тогда Продолжить; КонецЕсли;

		СтрокаЦены = ДокументУстановкаЦен.Товары2_5.Добавить();
		СтрокаЦены.Номенклатура = ДанныеЦены.Номенклатура;
		СтрокаЦены.ВидЦены = ВидЦены;
		СтрокаЦены.Цена = ДанныеЦены.Цена;
	КонецЦикла;

	ДокументУстановкаЦен.Записать(РежимЗаписиДокумента.Проведение);
	Возврат ДокументУстановкаЦен.Ссылка;
КонецФункции

Функция ПометитьДокументыНаУдаление(ИмяДокумента, ДокументыДляПометки) Экспорт
	ТекстЗапроса = СтрШаблон(
		"ВЫБРАТЬ
		|Документ.Ссылка КАК Ссылка
		|ИЗ
		|Документ.%1 КАК Документ
		|ГДЕ
		|Документ.Номер = &Номер
		|И Документ.Дата = &Дата",
		ИмяДокумента
	);
	Запрос = Новый Запрос(ТекстЗапроса);

	КоличествоПомеченных = 0;
	КоличествоУжеПомеченных = 0;
	КоличествоНеНайденных = 0;
	КоличествоОшибок = 0;

	Для Каждого ДокументДляПометки Из ДокументыДляПометки Цикл
		Запрос.УстановитьПараметр("Номер", ДокументДляПометки.Номер);
		Запрос.УстановитьПараметр("Дата", ДокументДляПометки.Дата);
		Выборка = Запрос.Выполнить().Выбрать();

		Если НЕ Выборка.Следующий() Тогда
			КоличествоНеНайденных = КоличествоНеНайденных + 1;
			Продолжить;
		КонецЕсли;

		Пока Истина Цикл
			Попытка
				ОбъектДокумента = Выборка.Ссылка.ПолучитьОбъект();
				Если ОбъектДокумента.ПометкаУдаления Тогда
					КоличествоУжеПомеченных = КоличествоУжеПомеченных + 1;
				Иначе
					ОбъектДокумента.УстановитьПометкуУдаления(Истина);
					КоличествоПомеченных = КоличествоПомеченных + 1;
				КонецЕсли;
			Исключение
				КоличествоОшибок = КоличествоОшибок + 1;
				SharedToolkit_ЖурналРегистрации.ЗаписатьОшибку(
					"SharedToolkit.МассоваяПометкаНаУдаление",
					ИнформацияОбОшибке(),
					Выборка.Ссылка
				);
			КонецПопытки;

			Если НЕ Выборка.Следующий() Тогда Прервать; КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура(
		"Помечено,УжеПомечено,НеНайдено,Ошибок",
		КоличествоПомеченных,
		КоличествоУжеПомеченных,
		КоличествоНеНайденных,
		КоличествоОшибок
	);
КонецФункции

#КонецОбласти
