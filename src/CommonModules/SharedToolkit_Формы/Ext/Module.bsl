#Область ПрограммныйИнтерфейс

// Источники HyperSnips: ОткрытьФормуОбъекта, ОткрытьФормуСписка,
// ОткрытьФормуОбщий, (Добавить|Вставить)Элемент, ПолеВводаПолное,
// Процедура.ОбновитьИдентификаторыИзСтаройФормы,
// СобытиеФормы.ПриСозданииНаСервере, ПроверкаЗаполненияНаСервере,
// ОбработкаЗаписиНового, ПередЗагрузкойДанныхИзНастроекНаСервере,
// ПриЗагрузкеДанныхИзНастроекНаСервере,
// ПриСохраненииДанныхВНастройкахНаСервере.

&НаКлиенте
Процедура ОткрытьФормуОбъекта(ИмяФормы, Ссылка, Владелец = Неопределено) Экспорт
	ПараметрыФормы = Новый Структура("Ключ", Ссылка);
	ОткрытьФорму(ИмяФормы, ПараметрыФормы, Владелец);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСписка(ИмяФормы, ИмяПоля, Значение, Владелец = Неопределено) Экспорт
	Отбор = Новый Структура;
	Отбор.Вставить(ИмяПоля, Значение);
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	ОткрытьФорму(ИмяФормы, ПараметрыФормы, Владелец);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСПараметрами(
	ИмяФормы,
	ПараметрыФормы = Неопределено,
	Владелец = Неопределено,
	КлючУникальности = "",
	Окно = Неопределено,
	НавигационнаяСсылка = Неопределено,
	ОповещениеОЗакрытии = Неопределено,
	РежимОткрытия = Неопределено) Экспорт

	Если РежимОткрытия = Неопределено Тогда
		РежимОткрытия = РежимОткрытияОкнаФормы.Независимый;
	КонецЕсли;

	ОткрытьФорму(
		ИмяФормы,
		ПараметрыФормы,
		Владелец,
		КлючУникальности,
		Окно,
		НавигационнаяСсылка,
		ОповещениеОЗакрытии,
		РежимОткрытия
	);
КонецПроцедуры

&НаКлиенте
Функция СоздатьПолеФормы(
	Форма,
	ИмяЭлемента,
	ПутьКДанным,
	Заголовок = "",
	Родитель = Неопределено,
	ПередЭлементом = Неопределено) Экспорт

	Если ПередЭлементом = Неопределено Тогда
		Если Родитель = Неопределено Тогда
			Элемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"));
		Иначе
			Элемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		КонецЕсли;
	ИначеЕсли Родитель = Неопределено Тогда
		Элемент = Форма.Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), ПередЭлементом);
	Иначе
		Элемент = Форма.Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), ПередЭлементом, Родитель);
	КонецЕсли;

	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.ПутьКДанным = ПутьКДанным;
	Элемент.Заголовок = Заголовок;
	Возврат Элемент;
КонецФункции

&НаКлиенте
Процедура НастроитьПолеФормы(
	Элемент,
	Вид = Неопределено,
	Подсказка = Неопределено,
	ЗаголовокРасширеннойПодсказки = Неопределено,
	РасширеннаяПодсказка = Неопределено,
	Видимость = Неопределено,
	Доступность = Неопределено,
	ТолькоПросмотр = Неопределено,
	Шрифт = Неопределено,
	ЦветТекста = Неопределено,
	ЦветФона = Неопределено,
	ШрифтЗаголовка = Неопределено,
	ЦветТекстаЗаголовка = Неопределено,
	АвтоВысота = Неопределено,
	АвтоШирина = Неопределено,
	Высота = Неопределено,
	Ширина = Неопределено,
	ПоложениеЗаголовка = Неопределено) Экспорт

	// Ложь, 0 и пустая строка могут быть переданы намеренно, например чтобы скрыть поле
	// или очистить подсказку; только Неопределено означает, что свойство менять не нужно.
	Если Вид <> Неопределено Тогда Элемент.Вид = Вид; КонецЕсли;
	Если Подсказка <> Неопределено Тогда Элемент.Подсказка = Подсказка; КонецЕсли;
	Если ЗаголовокРасширеннойПодсказки <> Неопределено Тогда Элемент.ЗаголовокРасширеннойПодсказки = ЗаголовокРасширеннойПодсказки; КонецЕсли;
	Если РасширеннаяПодсказка <> Неопределено Тогда Элемент.РасширеннаяПодсказка = РасширеннаяПодсказка; КонецЕсли;
	Если Видимость <> Неопределено Тогда Элемент.Видимость = Видимость; КонецЕсли;
	Если Доступность <> Неопределено Тогда Элемент.Доступность = Доступность; КонецЕсли;
	Если ТолькоПросмотр <> Неопределено Тогда Элемент.ТолькоПросмотр = ТолькоПросмотр; КонецЕсли;
	Если Шрифт <> Неопределено Тогда Элемент.Шрифт = Шрифт; КонецЕсли;
	Если ЦветТекста <> Неопределено Тогда Элемент.ЦветТекста = ЦветТекста; КонецЕсли;
	Если ЦветФона <> Неопределено Тогда Элемент.ЦветФона = ЦветФона; КонецЕсли;
	Если ШрифтЗаголовка <> Неопределено Тогда Элемент.ШрифтЗаголовка = ШрифтЗаголовка; КонецЕсли;
	Если ЦветТекстаЗаголовка <> Неопределено Тогда Элемент.ЦветТекстаЗаголовка = ЦветТекстаЗаголовка; КонецЕсли;
	Если АвтоВысота <> Неопределено Тогда Элемент.АвтоВысота = АвтоВысота; КонецЕсли;
	Если АвтоШирина <> Неопределено Тогда Элемент.АвтоШирина = АвтоШирина; КонецЕсли;
	Если Высота <> Неопределено Тогда Элемент.Высота = Высота; КонецЕсли;
	Если Ширина <> Неопределено Тогда Элемент.Ширина = Ширина; КонецЕсли;
	Если ПоложениеЗаголовка <> Неопределено Тогда Элемент.ПоложениеЗаголовка = ПоложениеЗаголовка; КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИдентификаторыИзСтаройФормы(
	ВладелецФормы,
	ТекущаяФорма,
	ИмяТЧОбъекта,
	СписокИдентификаторов) Экспорт

	Если НЕ ЗначениеЗаполнено(СписокИдентификаторов) Тогда Возврат; КонецЕсли;

	Для Индекс = 0 По СписокИдентификаторов.Количество() - 1 Цикл
		СтарыйИД = СписокИдентификаторов[Индекс].Значение;
		СтрокаСтарая = ВладелецФормы.Объект[ИмяТЧОбъекта].НайтиПоИдентификатору(СтарыйИД);
		Если НЕ ЗначениеЗаполнено(СтрокаСтарая) Тогда Продолжить; КонецЕсли;

		НомерСтроки = ВладелецФормы.Объект[ИмяТЧОбъекта].Индекс(СтрокаСтарая);
		Если НомерСтроки < 0 ИЛИ НомерСтроки >= ТекущаяФорма.Объект[ИмяТЧОбъекта].Количество() Тогда Продолжить; КонецЕсли;

		СтрокаНовая = ТекущаяФорма.Объект[ИмяТЧОбъекта][НомерСтроки];
		СписокИдентификаторов[Индекс].Значение = СтрокаНовая.ПолучитьИдентификатор();
	КонецЦикла;
КонецПроцедуры


&НаСервере
Процедура УдалитьИзПроверяемыхРеквизитов(ПроверяемыеРеквизиты, ИмяРеквизита) Экспорт
	Индекс = ПроверяемыеРеквизиты.Найти(ИмяРеквизита);
	Если Индекс <> Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(Индекс);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьВПроверяемыеРеквизиты(ПроверяемыеРеквизиты, ИмяРеквизита) Экспорт
	Индекс = ПроверяемыеРеквизиты.Найти(ИмяРеквизита);
	Если Индекс = Неопределено Тогда
		ПроверяемыеРеквизиты.Добавить(ИмяРеквизита);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
