#Область ПрограммныйИнтерфейс

// Источник HyperSnips: МассивВСтроку. Универсальный ОбъектВСтроку() заменяет
// отдельную вспомогательную функцию для массива и поддерживает также остальные коллекции.
// Преобразует произвольное значение в человекочитаемую строку.
//
// Простые значения и ссылки используют штатное строковое представление 1С.
// Универсальные коллекции, таблицы и деревья преобразуются рекурсивно.
// Функция предназначена для сообщений, логирования и диагностики, но не для
// сериализации или последующего восстановления исходного значения.
//
// Параметры:
//  Значение - Произвольный - преобразуемое значение.
//  Разделитель - Строка - разделитель элементов коллекций.
//  МаксимальнаяГлубина - Число - максимальная глубина рекурсивного обхода.
//  МаксимумЭлементов - Число - максимальное число элементов каждой коллекции.
//
// Возвращаемое значение:
//  Строка - человекочитаемое представление значения.
Функция ОбъектВСтроку(
	Знач Значение,
	Знач Разделитель = ", ",
	Знач МаксимальнаяГлубина = 10,
	Знач МаксимумЭлементов = 100
) Экспорт
	Если МаксимальнаяГлубина <= 0 Тогда Возврат "..."; КонецЕсли;
	Если МаксимумЭлементов < 1 Тогда МаксимумЭлементов = 1; КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Неопределено") Тогда Возврат "Неопределено"; КонецЕсли;
	Если ТипЗначения = Тип("Null") Тогда Возврат "Null"; КонецЕсли;
	Если ТипЗначения = Тип("Строка") Тогда Возврат Значение; КонецЕсли;

	Если ЗначениеОдногоИзТипов(Значение, "Массив,ФиксированныйМассив") Тогда Возврат ПоследовательностьВСтроку(Значение, Разделитель, МаксимальнаяГлубина, МаксимумЭлементов, Ложь); КонецЕсли;

	Если ТипЗначения = Тип("СписокЗначений") Тогда Возврат ПоследовательностьВСтроку(Значение, Разделитель, МаксимальнаяГлубина, МаксимумЭлементов, Истина); КонецЕсли;

	Если ЗначениеОдногоИзТипов(Значение, "Структура,ФиксированнаяСтруктура,Соответствие,ФиксированноеСоответствие") Тогда Возврат КлючЗначениеВСтроку(Значение, Разделитель, МаксимальнаяГлубина, МаксимумЭлементов); КонецЕсли;

	Если ТипЗначения = Тип("ДвоичныеДанные") Тогда Возврат СтрШаблон("<ДвоичныеДанные: %1 байт>", Значение.Размер()); КонецЕсли;
	Если ТипЗначения = Тип("ТекстовыйДокумент") Тогда Возврат Значение.ПолучитьТекст(); КонецЕсли;

#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда
	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда Возврат ТаблицаЗначенийВСтроку(Значение, Разделитель, МаксимальнаяГлубина, МаксимумЭлементов); КонецЕсли;
	Если ТипЗначения = Тип("ДеревоЗначений") Тогда Возврат ДеревоЗначенийВСтроку(Значение, Разделитель, МаксимальнаяГлубина, МаксимумЭлементов); КонецЕсли;
	Если ТипЗначения = Тип("РезультатЗапроса") Тогда Возврат ОбъектВСтроку(Значение.Выгрузить(), Разделитель, МаксимальнаяГлубина - 1, МаксимумЭлементов); КонецЕсли;
#КонецЕсли

	Попытка
		Представление = Строка(Значение);
	Исключение
		Возврат "<" + Строка(ТипЗначения) + ">";
	КонецПопытки;

	Если ЗначениеЗаполнено(Представление) Тогда Возврат Представление; КонецЕсли;
	Возврат "<" + Строка(ТипЗначения) + ">";
КонецФункции

// Проверяет, относится ли значение к одному из допустимых типов.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//  ДопустимыеТипы - Строка - имена типов через запятую, например "Структура,Соответствие".
//                  - ОписаниеТипов - готовое описание допустимых типов.
//                  - Тип - один допустимый тип.
//                  - Массив, ФиксированныйМассив - элементы типа Тип или Строка.
//
// Возвращаемое значение:
//  Булево - Истина, если ТипЗнч(Значение) входит в ДопустимыеТипы.
Функция ЗначениеОдногоИзТипов(Знач Значение, Знач ДопустимыеТипы) Экспорт
	ТипДопустимыхТипов = ТипЗнч(ДопустимыеТипы);
	Если ТипДопустимыхТипов = Тип("ОписаниеТипов") Тогда Возврат ДопустимыеТипы.СодержитТип(ТипЗнч(Значение)); КонецЕсли;
	Если ТипДопустимыхТипов = Тип("Строка") Тогда Возврат Новый ОписаниеТипов(ДопустимыеТипы).СодержитТип(ТипЗнч(Значение)); КонецЕсли;
	Если ТипДопустимыхТипов = Тип("Тип") Тогда Возврат ТипЗнч(Значение) = ДопустимыеТипы; КонецЕсли;

	ТипыКоллекцийТипов = Новый ОписаниеТипов("Массив,ФиксированныйМассив");
	Если ТипыКоллекцийТипов.СодержитТип(ТипДопустимыхТипов) Тогда
		Для Каждого ДопустимыйТип Из ДопустимыеТипы Цикл
			Если ЗначениеОдногоИзТипов(Значение, ДопустимыйТип) Тогда Возврат Истина; КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Неподдерживаемое описание допустимых типов: %1", ТипДопустимыхТипов);
КонецФункции

// Универсально проверяет заполненность значения.
//
// Для типов с однозначным понятием пустоты используется явная проверка типа.
// Остальные значения передаются штатному ЗначениеЗаполнено(). Поэтому функция
// работает с ТаблицаЗначений, ДеревоЗначений, Структура, Соответствие,
// СписокЗначений, массивами, табличными частями, наборами записей,
// РезультатЗапроса, ДвоичныеДанные и другими поддерживаемыми платформой типами.
//
// Для неизвестного типа, для которого невозможно определить собственное
// понятие пустоты, существующий экземпляр считается заполненным.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение считается заполненным.
Функция ЗначениеЗаполненоРасширенно(Знач Значение) Экспорт
	ТипЗначения = ТипЗнч(Значение);

	// Универсальные коллекции, доступные и на клиенте, и на сервере.
	Если ЗначениеОдногоИзТипов(
		Значение,
		"Массив,ФиксированныйМассив,Структура,ФиксированнаяСтруктура,Соответствие,ФиксированноеСоответствие,СписокЗначений"
	) Тогда Возврат Значение.Количество() > 0; КонецЕсли;
	Если ТипЗначения = Тип("ДвоичныеДанные") Тогда Возврат Значение.Размер() > 0; КонецЕсли;
	Если ТипЗначения = Тип("ТекстовыйДокумент") Тогда Возврат ЗначениеЗаполнено(Значение.ПолучитьТекст()); КонецЕсли;

	// Эти типы недоступны в тонком и веб-клиенте, поэтому ссылки на них
	// компилируются только в тех контекстах, где платформа их предоставляет.
#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда
	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда Возврат Значение.Количество() > 0; КонецЕсли;
	Если ТипЗначения = Тип("ДеревоЗначений") Тогда Возврат Значение.Строки.Количество() > 0; КонецЕсли;
	Если ТипЗначения = Тип("РезультатЗапроса") Тогда Возврат НЕ Значение.Пустой(); КонецЕсли;
#КонецЕсли

	// Штатная функция покрывает простые типы, ссылки и остальные коллекции,
	// в том числе прикладные коллекции вроде табличных частей и наборов записей.
	Попытка
		Возврат ЗначениеЗаполнено(Значение);
	Исключение
		// Для прочих мутабельных объектов платформа не задает универсального
		// состояния "пусто". Сам факт существования экземпляра считаем заполнением.
		Возврат Истина;
	КонецПопытки;
КонецФункции

// Присваивает новое значение приемнику, только если оно заполнено.
// Первый параметр намеренно передается по ссылке, второй — по значению.
//
// Параметры:
//  Приемник - Произвольный - изменяемая переменная или доступное для записи свойство.
//  Источник - Произвольный - значение, проверяемое через ЗначениеЗаполненоРасширенно().
Процедура ПрисвоитьЕслиЗаполнено(Приемник, Знач Источник) Экспорт
	Если НЕ ЗначениеЗаполненоРасширенно(Источник) Тогда Возврат; КонецЕсли;
	Приемник = Источник;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбъектВСтроку

Функция ПоследовательностьВСтроку(
	Знач Коллекция,
	Знач Разделитель,
	Знач МаксимальнаяГлубина,
	Знач МаксимумЭлементов,
	Знач ЭтоСписокЗначений
)
	Части = Новый Массив;
	НомерЭлемента = 0;

	Для Каждого Элемент Из Коллекция Цикл
		Если НомерЭлемента >= МаксимумЭлементов Тогда
			Части.Добавить("...");
			Прервать;
		КонецЕсли;

		Если ЭтоСписокЗначений Тогда Элемент = Элемент.Значение; КонецЕсли;
		Части.Добавить(ОбъектВСтроку(
			Элемент,
			Разделитель,
			МаксимальнаяГлубина - 1,
			МаксимумЭлементов
		));
		НомерЭлемента = НомерЭлемента + 1;
	КонецЦикла;

	Возврат "[" + СтрСоединить(Части, Разделитель) + "]";
КонецФункции

Функция КлючЗначениеВСтроку(
	Знач Коллекция,
	Знач Разделитель,
	Знач МаксимальнаяГлубина,
	Знач МаксимумЭлементов
)
	Части = Новый Массив;
	НомерЭлемента = 0;

	Для Каждого Элемент Из Коллекция Цикл
		Если НомерЭлемента >= МаксимумЭлементов Тогда
			Части.Добавить("...");
			Прервать;
		КонецЕсли;

		Ключ = ОбъектВСтроку(
			Элемент.Ключ,
			Разделитель,
			МаксимальнаяГлубина - 1,
			МаксимумЭлементов
		);
		ПредставлениеЗначения = ОбъектВСтроку(
			Элемент.Значение,
			Разделитель,
			МаксимальнаяГлубина - 1,
			МаксимумЭлементов
		);
		Части.Добавить(Ключ + ": " + ПредставлениеЗначения);
		НомерЭлемента = НомерЭлемента + 1;
	КонецЦикла;

	Возврат "{" + СтрСоединить(Части, Разделитель) + "}";
КонецФункции

#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда
Функция ТаблицаЗначенийВСтроку(
	Знач Таблица,
	Знач Разделитель,
	Знач МаксимальнаяГлубина,
	Знач МаксимумЭлементов
)
	Строки = Новый Массив;
	НомерСтроки = 0;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если НомерСтроки >= МаксимумЭлементов Тогда
			Строки.Добавить("...");
			Прервать;
		КонецЕсли;

		ЗначенияСтроки = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			ПредставлениеЗначения = ОбъектВСтроку(
				СтрокаТаблицы[Колонка.Имя],
				Разделитель,
				МаксимальнаяГлубина - 1,
				МаксимумЭлементов
			);
			ЗначенияСтроки.Добавить(Колонка.Имя + ": " + ПредставлениеЗначения);
		КонецЦикла;

		Строки.Добавить("{" + СтрСоединить(ЗначенияСтроки, Разделитель) + "}");
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	Возврат "[" + СтрСоединить(Строки, Разделитель) + "]";
КонецФункции

Функция ДеревоЗначенийВСтроку(
	Знач Дерево,
	Знач Разделитель,
	Знач МаксимальнаяГлубина,
	Знач МаксимумЭлементов
)
	Возврат СтрокиДереваВСтроку(
		Дерево.Строки,
		Дерево.Колонки,
		Разделитель,
		МаксимальнаяГлубина,
		МаксимумЭлементов
	);
КонецФункции

Функция СтрокиДереваВСтроку(
	Знач СтрокиДерева,
	Знач Колонки,
	Знач Разделитель,
	Знач МаксимальнаяГлубина,
	Знач МаксимумЭлементов
)
	Если МаксимальнаяГлубина <= 0 Тогда Возврат "..."; КонецЕсли;

	Строки = Новый Массив;
	НомерСтроки = 0;

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если НомерСтроки >= МаксимумЭлементов Тогда
			Строки.Добавить("...");
			Прервать;
		КонецЕсли;

		ЗначенияСтроки = Новый Массив;
		Для Каждого Колонка Из Колонки Цикл
			ПредставлениеЗначения = ОбъектВСтроку(
				СтрокаДерева[Колонка.Имя],
				Разделитель,
				МаксимальнаяГлубина - 1,
				МаксимумЭлементов
			);
			ЗначенияСтроки.Добавить(Колонка.Имя + ": " + ПредставлениеЗначения);
		КонецЦикла;

		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			ПодчиненныеСтроки = СтрокиДереваВСтроку(
				СтрокаДерева.Строки,
				Колонки,
				Разделитель,
				МаксимальнаяГлубина - 1,
				МаксимумЭлементов
			);
			ЗначенияСтроки.Добавить("Строки: " + ПодчиненныеСтроки);
		КонецЕсли;

		Строки.Добавить("{" + СтрСоединить(ЗначенияСтроки, Разделитель) + "}");
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	Возврат "[" + СтрСоединить(Строки, Разделитель) + "]";
КонецФункции
#КонецЕсли

#КонецОбласти

#КонецОбласти
