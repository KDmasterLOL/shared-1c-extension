#Область ПрограммныйИнтерфейс

// Источники HyperSnips: ОткрытьФормуДополнительнойОбработкиБСП,
// ОткрытьФормуДополнительнойОбработки, ДобавитьКомандуВнешнейОбработки,
// ЗапросДополнительныйОтчетИлиОбработка,
// ПолучитьСсылкуНаДополнительнуюОбработкуПоИмени,
// РаботаСНастройкамиВнешнейОбработки,
// Функция.СведенияОВнешнейОбработке,
// Функция.ПодготовитьДанныеДляДлительнойОперации.

&НаКлиенте
Процедура ОткрытьФормуДополнительнойОбработкиБСП(
	Обработка,
	ПараметрыДляФормы,
	ИмяФормы) Экспорт

	ВыполняемаяКоманда = Новый Структура;
	ВыполняемаяКоманда.Вставить(
		"ВариантЗапуска",
		ПредопределенноеЗначение("Перечисление.СпособыВызоваДополнительныхОбработок.ОткрытиеФормы")
	);
	ВыполняемаяКоманда.Вставить(
		"Вид",
		ПредопределенноеЗначение("Перечисление.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка")
	);
	ВыполняемаяКоманда.Вставить("Идентификатор", "");
	ВыполняемаяКоманда.Вставить("Модификатор", "");
	ОбъектыНазначения = Новый Массив;
	ОбъектыНазначения.Добавить(ПараметрыДляФормы);
	ВыполняемаяКоманда.Вставить("ОбъектыНазначения", ОбъектыНазначения);
	ВыполняемаяКоманда.Вставить("ПоказыватьОповещение", Истина);
	ВыполняемаяКоманда.Вставить("Представление", Строка(Обработка));
	ВыполняемаяКоманда.Вставить("Ссылка", Обработка);
	ВыполняемаяКоманда.Вставить("ЭтоОтчет", Ложь);

	ФормаОткрытия = Новый Структура("ИмяФормы", ИмяФормы);
	ДополнительныеОтчетыИОбработкиКлиент.ВыполнитьОткрытиеФормыОбработки(
		ВыполняемаяКоманда,
		ФормаОткрытия,
		ВыполняемаяКоманда.ОбъектыНазначения
	);
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьИОткрытьВнешнююОбработку(
	СсылкаНаОбработку,
	ИмяФормы,
	ПараметрыФормы = Неопределено) Экспорт

	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(СсылкаНаОбработку);
	ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма." + ИмяФормы, ПараметрыФормы);
КонецПроцедуры

&НаСервере
Функция НайтиДополнительнуюОбработкуПоИмениОбъекта(ИмяОбъекта) Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|ДО.Ссылка КАК Ссылка
		|ИЗ
		|Справочник.ДополнительныеОтчетыИОбработки КАК ДО
		|ГДЕ
		|НЕ ДО.ПометкаУдаления
		|И ДО.ИмяОбъекта = &ИмяОбъекта
		|И ДО.Публикация = ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)"
	);
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

&НаСервере
Процедура ДобавитьКоманду(
	ПараметрыРегистрации,
	Идентификатор,
	Представление,
	Использование,
	ПоказыватьОповещение = Ложь,
	Модификатор = "") Экспорт

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Идентификатор = Идентификатор;
	Команда.Представление = Представление;
	Команда.Использование = Использование;
	Команда.ПоказыватьОповещение = ПоказыватьОповещение;
	Команда.Модификатор = Модификатор;
КонецПроцедуры

&НаСервере
Функция СоздатьСведенияОВнешнейОбработке(МетаданныеОбъекта, ВидОбработки) Экспорт
	ИмяОбработки = МетаданныеОбъекта.Имя;
	Синоним = МетаданныеОбъекта.Синоним;
	Синоним = ?(ЗначениеЗаполнено(Синоним), Синоним, ИмяОбработки);
	ВерсияОбработки = МетаданныеОбъекта.Комментарий;

	ВерсияБСП = СтандартныеПодсистемыСервер.ВерсияБиблиотеки();
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке(ВерсияБСП);
	ПараметрыРегистрации.Наименование = Синоним;
	ПараметрыРегистрации.Вид = ВидОбработки;
	ПараметрыРегистрации.Версия = ВерсияОбработки;
	ПараметрыРегистрации.Информация = Синоним;
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	Возврат ПараметрыРегистрации;
КонецФункции

&НаСервере
Процедура СохранитьНастройки(ОбъектОбработки, ИмяНастройки) Экспорт
	Если Метаданные.Справочники.Найти("ВариантыОтчетов") = Неопределено Тогда Возврат; КонецЕсли;

	СтруктураНастроек = Новый Структура;
	Для Каждого Реквизит Из ОбъектОбработки.Метаданные().Реквизиты Цикл
		Если ТипЗнч(ОбъектОбработки[Реквизит.Имя]) <> Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
			СтруктураНастроек.Вставить(Реквизит.Имя, ОбъектОбработки[Реквизит.Имя]);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из ОбъектОбработки.Метаданные().ТабличныеЧасти Цикл
		СтруктураНастроек.Вставить(ТабличнаяЧасть.Имя, ОбъектОбработки[ТабличнаяЧасть.Имя].Выгрузить());
	КонецЦикла;

	НайденнаяНастройка = Справочники.ВариантыОтчетов.НайтиПоНаименованию(ИмяНастройки);
	Если НЕ ЗначениеЗаполнено(НайденнаяНастройка) Тогда
		ОбъектНастройки = Справочники.ВариантыОтчетов.СоздатьЭлемент();
	Иначе
		ОбъектНастройки = НайденнаяНастройка.ПолучитьОбъект();
	КонецЕсли;
	ОбъектНастройки.Наименование = ИмяНастройки;
	ОбъектНастройки.Настройки = Новый ХранилищеЗначения(СтруктураНастроек);
	ОбъектНастройки.Записать();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки(ОбъектОбработки, ИмяНастройки) Экспорт
	Если Метаданные.Справочники.Найти("ВариантыОтчетов") = Неопределено Тогда Возврат; КонецЕсли;

	НайденнаяНастройка = Справочники.ВариантыОтчетов.НайтиПоНаименованию(ИмяНастройки);
	Если НЕ ЗначениеЗаполнено(НайденнаяНастройка) Тогда Возврат; КонецЕсли;

	СтруктураНастроек = НайденнаяНастройка.Настройки.Получить();
	Если ТипЗнч(СтруктураНастроек) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Для Каждого ЭлементНастройки Из СтруктураНастроек Цикл
		Если ТипЗнч(ЭлементНастройки.Значение) = Тип("ТаблицаЗначений")
			И ОбъектОбработки.Метаданные().ТабличныеЧасти.Найти(ЭлементНастройки.Ключ) <> Неопределено Тогда
			ОбъектОбработки[ЭлементНастройки.Ключ].Загрузить(ЭлементНастройки.Значение);
		ИначеЕсли ОбъектОбработки.Метаданные().Реквизиты.Найти(ЭлементНастройки.Ключ) <> Неопределено Тогда
			ОбъектОбработки[ЭлементНастройки.Ключ] = ЭлементНастройки.Значение;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляДлительнойОперации(
	ИспользуемоеИмяФайла,
	ДополнительнаяОбработкаСсылка = Неопределено) Экспорт

	Результат = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	Результат.Вставить("ЭтоВнешняяОбработка", Истина);
	Результат.Вставить("ИспользуемоеИмяФайла", ИспользуемоеИмяФайла);
	Если ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
		Результат.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти
