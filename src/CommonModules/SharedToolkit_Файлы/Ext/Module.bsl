#Область ПрограммныйИнтерфейс

// Источники HyperSnips: ВыборФайла, ЗагрузитьФайл.
// Обработчики обратного вызова остаются в модуле формы; здесь только переиспользуемая логика.

&НаКлиенте
Функция СоздатьДиалогВыбораФайла(
	Заголовок = "Выберите файл",
	Фильтр = "Все файлы (*.*)|*.*",
	МножественныйВыбор = Ложь) Экспорт

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = Заголовок;
	Диалог.Фильтр = Фильтр;
	Диалог.МножественныйВыбор = МножественныйВыбор;
	Возврат Диалог;
КонецФункции

&НаКлиенте
Функция ПервыйВыбранныйФайл(ВыбранныеФайлы) Экспорт
	Если НЕ ЗначениеЗаполнено(ВыбранныеФайлы) Тогда Возврат Неопределено; КонецЕсли;
	Возврат ВыбранныеФайлы[0];
КонецФункции

&НаСервере
Функция ПолучитьДвоичныеДанные(АдресВременногоХранилища) Экспорт
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	Если НЕ ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		ВызватьИсключение "Файл во временном хранилище не найден.";
	КонецЕсли;
	Возврат ДвоичныеДанные;
КонецФункции

&НаСервере
Функция ЗаписатьВоВременныйФайл(АдресВременногоХранилища, Расширение) Экспорт
	ДвоичныеДанные = ПолучитьДвоичныеДанные(АдресВременногоХранилища);
	ИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ИмяФайла);
	Возврат ИмяФайла;
КонецФункции

&НаСервере
Процедура ОчиститьВременныеДанные(АдресВременногоХранилища, ИмяФайла = "") Экспорт
	Если ЗначениеЗаполнено(АдресВременногоХранилища) Тогда
		УдалитьИзВременногоХранилища(АдресВременногоХранилища);
	КонецЕсли;

	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		Попытка
			УдалитьФайлы(ИмяФайла);
		Исключение
			SharedToolkit_ЖурналРегистрации.ЗаписатьОшибку(
				"SharedToolkit.УдалениеВременногоФайла",
				ИнформацияОбОшибке()
			);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
