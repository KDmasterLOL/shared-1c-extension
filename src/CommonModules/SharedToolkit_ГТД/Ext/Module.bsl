#Область ПрограммныйИнтерфейс

// Источник HyperSnips: Функция.СоздатьТаможеннуюДекларациюИмпортПоJSON.
// Код перенесен в отдельный УТ-специфичный модуль и параметризован основанием ГТД.

Функция СоздатьТаможеннуюДекларациюИмпортПоJSON(
	JSON,
	ОснованиеГТД,
	КодТаможенногоБрокера = "БП-000363") Экспорт

	ДанныеГТД = ?(
		ТипЗнч(JSON) = Тип("Строка"),
		SharedToolkit_JSON.ПрочитатьJSONИзСтроки(JSON),
		JSON
	);

	Если НЕ ЗначениеЗаполнено(ОснованиеГТД) Тогда
		ВызватьИсключение "Не задано основание ГТД.";
	КонецЕсли;

	ДокументДекларации = Документы.ТаможеннаяДекларацияИмпорт.СоздатьДокумент();
	ЗаполнитьШапку(ДокументДекларации, ДанныеГТД, КодТаможенногоБрокера);
	ЗаполнитьПлатежи(ДокументДекларации, ДанныеГТД);
	ЗаполнитьРазделыИТовары(ДокументДекларации, ОснованиеГТД, ДанныеГТД);
	ЗаполнитьСуммы(ДокументДекларации, ДанныеГТД);

	Если ТипЗнч(JSON) = Тип("Строка") Тогда
		ДокументДекларации.Комментарий =
			"Документ создан программно SharedToolkit" + Символы.ПС + JSON;
	КонецЕсли;

	ДокументДекларации.Дата = ТекущаяДатаСеанса();
	ДокументДекларации.Записать();
	Возврат ДокументДекларации.Ссылка;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьШапку(ДокументДекларации, ДанныеГТД, КодТаможенногоБрокера)
	ДокументДекларации.ВариантОформления =
		Перечисления.ХозяйственныеОперации.ОформлениеГТДСамостоятельно;
	ДокументДекларации.Партнер = Справочники.Партнеры.НайтиПоКоду(КодТаможенногоБрокера);
	ДокументДекларации.Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту(
		"Партнер",
		ДокументДекларации.Партнер
	);
	ДокументДекларации.Валюта = Справочники.Валюты.НайтиПоНаименованию(ДанныеГТД.deal.currency);
	ДокументДекларации.ВалютаВзаиморасчетов = ДокументДекларации.Валюта;
	ДокументДекларации.ФормаОплаты = Перечисления.ФормыОплаты.Безналичная;
	ДокументДекларации.КурсЧислитель = 1;
	ДокументДекларации.КурсЗнаменатель = 1;

	Если ДанныеГТД.Свойство("gtd") Тогда
		ДокументДекларации.НомерДекларации = ДанныеГТД.gtd + "/1";
	КонецЕсли;

	Участники = SharedToolkit_Коллекции.ПолучитьИзКоллекции(ДанныеГТД, "participants");
	Если ЗначениеЗаполнено(Участники)
		И Участники.Свойство("consignee_name")
		И ЗначениеЗаполнено(Участники.consignee_name) Тогда
		ДокументДекларации.Организация = НайтиОрганизацию(Участники.consignee_name);
	КонецЕсли;

	Если ЗначениеЗаполнено(Участники)
		И Участники.Свойство("shipper_name")
		И ЗначениеЗаполнено(Участники.shipper_name) Тогда
		ДокументДекларации.Поставщик = Справочники.Партнеры.НайтиПоНаименованию(
			Участники.shipper_name,
			Ложь
		);
		ДокументДекларации.КонтрагентПоставщика = Справочники.Контрагенты.НайтиПоРеквизиту(
			"Партнер",
			ДокументДекларации.Поставщик
		);
	КонецЕсли;

	ДокументДекларации.Статус = Перечисления.СтатусыТаможенныхДеклараций.ВыпущеноСТаможни;
КонецПроцедуры

Функция НайтиОрганизацию(Значение)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|Организации.Ссылка КАК Ссылка
		|ИЗ
		|Справочник.Организации КАК Организации
		|ГДЕ
		|ВРег(Организации.НаименованиеСокращенное) = ВРег(&НаименованиеСокращенное)"
	);
	Запрос.УстановитьПараметр("НаименованиеСокращенное", Значение);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
КонецФункции

Процедура ЗаполнитьПлатежи(ДокументДекларации, ДанныеГТД)
	Платежи = SharedToolkit_Коллекции.ПолучитьИзКоллекции(ДанныеГТД, "payments");
	Если НЕ ЗначениеЗаполнено(Платежи) Тогда Возврат; КонецЕсли;

	СтрокиПлатежей = SharedToolkit_Коллекции.ПолучитьИзКоллекции(Платежи, "lines");
	Если ТипЗнч(СтрокиПлатежей) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	ТаможенныйСбор = 0;
	Для Каждого ДанныеСтроки Из СтрокиПлатежей Цикл
		Если ДанныеСтроки.Свойство("code") И ДанныеСтроки.code = "1010"
			И ДанныеСтроки.Свойство("amount") Тогда
			ТаможенныйСбор = Число(ДанныеСтроки.amount);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ДанныеСтроки Из СтрокиПлатежей Цикл
		Если НЕ ДанныеСтроки.Свойство("amount") Тогда Продолжить; КонецЕсли;
		СуммаСтроки = Число(ДанныеСтроки.amount);
		Если НЕ ЗначениеЗаполнено(СуммаСтроки) Тогда Продолжить; КонецЕсли;

		СтрокаПлатежа = ДокументДекларации.РасшифровкаПлатежа.Добавить();
		СтрокаПлатежа.Сумма = СуммаСтроки;
		СтрокаПлатежа.СуммаВзаиморасчетов = СуммаСтроки;
	КонецЦикла;

	Если ЗначениеЗаполнено(ТаможенныйСбор) Тогда
		ДокументДекларации.ТаможенныйСбор = ТаможенныйСбор;
	КонецЕсли;

	СтатьяСбора = ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоНаименованию("налоги и сборы", Ложь);
	Если ЗначениеЗаполнено(СтатьяСбора) Тогда
		ДокументДекларации.СтатьяРасходовСбор = СтатьяСбора;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьРазделыИТовары(ДокументДекларации, ОснованиеГТД, ДанныеГТД)
	СтранаПроисхождения = Справочники.СтраныМира.НайтиПоНаименованию(
		ДанныеГТД.participants.country_from,
		Ложь
	);
	ДокументДекларации.ИспользоватьРазделы = Истина;
	СтрокаРаздела = ДокументДекларации.Разделы.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаРаздела, ОснованиеГТД.Товары[0]);
	СтрокаРаздела.ТаможеннаяСтоимость = ДанныеГТД.deal.invoice_amount;
	СтрокаРаздела.НомерРаздела = 1;
	СтрокаРаздела.СтранаПроисхождения = СтранаПроисхождения;

	ТоварыГТД = SharedToolkit_Коллекции.ПолучитьИзКоллекции(ДанныеГТД, "items", Новый Массив);
	ПроверенныеТовары = Новый Соответствие;
	ТоварыСвертка = ОснованиеГТД.Товары.Выгрузить();
	ТоварыСвертка.Свернуть("Номенклатура", "Сумма,Количество");

	Для Каждого СтрокаТоварыГТД Из ТоварыГТД Цикл
		Отбор = Новый Структура("Количество,Сумма", СтрокаТоварыГТД.qty, СтрокаТоварыГТД.amount);
		Товары = ТоварыСвертка.НайтиСтроки(Отбор);
		Если ЗначениеЗаполнено(Товары) Тогда
			ПроверенныеТовары.Вставить(Товары[0].Номенклатура, Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТовараОснования Из ОснованиеГТД.Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовараОснования.Номенклатура)
			ИЛИ НЕ ЗначениеЗаполнено(ПроверенныеТовары.Получить(СтрокаТовараОснования.Номенклатура)) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТовара = ДокументДекларации.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТовара, СтрокаТовараОснования);
		СтрокаТовара.ТаможеннаяСтоимость = СтрокаТовараОснования.Цена;
		СтрокаТовара.НомерРаздела = 1;
		СтрокаТовара.СтранаПроисхождения = СтранаПроисхождения;
		СтрокаТовара.НомерДляСФ = ДокументДекларации.НомерДекларации;
		СтрокаТовара.ДокументПоступления = ОснованиеГТД;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьСуммы(ДокументДекларации, ДанныеГТД)
	Если ЗначениеЗаполнено(ДокументДекларации.СуммаДокумента)
		ИЛИ ЗначениеЗаполнено(ДокументДекларации.СуммаВзаиморасчетов) Тогда
		Возврат;
	КонецЕсли;

	Платежи = SharedToolkit_Коллекции.ПолучитьИзКоллекции(ДанныеГТД, "payments");
	ИтогоПлатежей = SharedToolkit_Коллекции.ПолучитьИзКоллекции(Платежи, "total");
	ЗначениеСуммы = SharedToolkit_Коллекции.ПолучитьИзКоллекции(ИтогоПлатежей, "amount");
	Если НЕ ЗначениеЗаполнено(ЗначениеСуммы) Тогда Возврат; КонецЕсли;

	ЗначениеСуммы = Число(ЗначениеСуммы);
	ДокументДекларации.СуммаДокумента = ЗначениеСуммы;
	ДокументДекларации.СуммаВзаиморасчетов = ЗначениеСуммы;
КонецПроцедуры

#КонецОбласти
