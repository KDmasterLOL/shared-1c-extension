#Область ПрограммныйИнтерфейс

// Шаблоны кода для коллекций оставлены в HyperSnips, когда их смысл — именно шаблон
// управляющего кода, а не самостоятельная операция.

#Область Содержит

// Проверяет принадлежность элемента коллекции с учетом ее естественной семантики.
// Для структур и соответствий по умолчанию проверяется ключ; режим "Знч" переключает
// поиск на значения. Для остальных коллекций режим поиска не задается.
//
// Параметры:
//  Коллекция - Массив, ФиксированныйМассив, Структура, ФиксированнаяСтруктура,
//              Соответствие, ФиксированноеСоответствие, СписокЗначений,
//              ТаблицаЗначений, ДеревоЗначений - проверяемая коллекция.
//  Элемент - Произвольный - искомое значение, ключ или строка коллекции.
//  РежимПоиска - Неопределено, "Ключ", "Знч" - для структур и соответствий;
//      Неопределено эквивалентно "Ключ".
//
// Возвращаемое значение:
//  Булево - Истина, если элемент принадлежит коллекции.
Функция Содержит(Коллекция, Элемент, РежимПоиска = Неопределено) Экспорт
	СуффиксыПоТипам = Новый Соответствие;
	СуффиксыПоТипам.Вставить(Тип("Массив"), "ВМассиве");
	СуффиксыПоТипам.Вставить(Тип("ФиксированныйМассив"), "ВМассиве");
	СуффиксыПоТипам.Вставить(Тип("Структура"), "ВСтруктуре");
	СуффиксыПоТипам.Вставить(Тип("ФиксированнаяСтруктура"), "ВСтруктуре");
	СуффиксыПоТипам.Вставить(Тип("Соответствие"), "ВСоответствии");
	СуффиксыПоТипам.Вставить(Тип("ФиксированноеСоответствие"), "ВСоответствии");
	СуффиксыПоТипам.Вставить(Тип("СписокЗначений"), "ВСпискеЗначений");

#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда
	СуффиксыПоТипам.Вставить(Тип("ТаблицаЗначений"), "ВТаблицеЗначений");
	СуффиксыПоТипам.Вставить(Тип("ДеревоЗначений"), "ВДеревеЗначений");
#КонецЕсли

	ТипКоллекции = ТипЗнч(Коллекция);
	Суффикс = СуффиксыПоТипам.Получить(ТипКоллекции);
	Если Суффикс = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неподдерживаемый тип коллекции для проверки вхождения: %1", ТипКоллекции);
	КонецЕсли;

	КоллекцияКлючЗнч = SharedToolkit_Значения.ЗначениеОдногоИзТипов(
		Коллекция,
		"Структура,ФиксированнаяСтруктура,Соответствие,ФиксированноеСоответствие"
	);
	Если НЕ КоллекцияКлючЗнч И РежимПоиска <> Неопределено Тогда
		ВызватьИсключение "Режим поиска поддерживается только для коллекций ключ-значение";
	КонецЕсли;

	Результат = Ложь;
	Выполнить("Результат = Содержит" + Суффикс + "(Коллекция, Элемент, РежимПоиска);");
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область КоллекцииКлючЗначение

// Источник HyperSnips: Функция.Получить.
// Возвращает значение по ключу из коллекции ключ-значение.
// Если ключ отсутствует, возвращается ЗначениеПоУмолчанию.
// При заданном ОжидаемыйТип значение при необходимости приводится средствами платформы.
//
// Параметры:
//  Коллекция - Структура, ФиксированнаяСтруктура, Соответствие,
//              ФиксированноеСоответствие - источник значения.
//  Ключ - Произвольный - ключ значения; для структур должен быть именем свойства.
//  ЗначениеПоУмолчанию - Произвольный - возвращается, если ключ отсутствует.
//  ОжидаемыйТип - Неопределено - тип не проверяется;
//               - Тип - один ожидаемый тип;
//               - ОписаниеТипов - один или несколько допустимых типов.
//
// Возвращаемое значение:
//  Произвольный - найденное или приведенное значение, либо значение по умолчанию.
Функция ПолучитьИзКоллекции(
	Коллекция,
	Ключ,
	ЗначениеПоУмолчанию = Неопределено,
	ОжидаемыйТип = Неопределено
) Экспорт
	Значение = ЗначениеПоУмолчанию;
	Найдено = Ложь;

	Если Коллекция <> Неопределено Тогда
		Если НЕ ЭтоКоллекцияКлючЗначение(Коллекция) Тогда
			ВызватьИсключение СтрШаблон("Неподдерживаемый тип коллекции ключ-значение: %1", ТипЗнч(Коллекция));
		КонецЕсли;

		Если SharedToolkit_Значения.ЗначениеОдногоИзТипов(Коллекция, "Структура,ФиксированнаяСтруктура") Тогда
			Найдено = Коллекция.Свойство(Строка(Ключ), Значение);
		ИначеЕсли Содержит(Коллекция, Ключ) Тогда
			Значение = Коллекция.Получить(Ключ);
			Найдено = Истина;
		КонецЕсли;
	КонецЕсли;

	Если НЕ Найдено Тогда Значение = ЗначениеПоУмолчанию; КонецЕсли;
	Если ОжидаемыйТип = Неопределено Тогда Возврат Значение; КонецЕсли;

	Возврат ПреобразоватьВ(Значение, ОжидаемыйТип);
КонецФункции

#КонецОбласти

#Область Преобразование

// Преобразует значение в указанный тип.
// Для зарегистрированных сложных типов используется специализированное преобразование;
// для остальных типов — штатное приведение через ОписаниеТипов.ПривестиЗначение().
//
// Параметры:
//  ИсходноеЗнч - Произвольный - преобразуемое значение.
//  ТипРезультата - Тип, ОписаниеТипов - требуемый тип результата.
//  Параметры - Неопределено, Структура, ФиксированнаяСтруктура - параметры сложного преобразования.
//      Для коллекции ключ-значение -> ТаблицаЗначений:
//          * ИмяКолонкиКлюча - Строка, по умолчанию "Ключ";
//          * ИмяКолонкиЗнч - Строка, по умолчанию "Значение".
//
// Возвращаемое значение:
//  Произвольный - значение требуемого типа.
Функция ПреобразоватьВ(ИсходноеЗнч, ТипРезультата, Параметры = Неопределено) Экспорт
	ОписаниеРезультата = ПолучитьОписаниеТиповРезультата(ТипРезультата);
	Если ОписаниеРезультата.СодержитТип(ТипЗнч(ИсходноеЗнч)) Тогда Возврат ИсходноеЗнч; КонецЕсли;

	ТипыРезультата = ОписаниеРезультата.Типы();
	Если ТипыРезультата.Количество() = 1 Тогда
		ИмяПреобразования = ПолучитьИмяСложногоПреобразования(ТипЗнч(ИсходноеЗнч), ТипыРезультата[0]);
		Если ИмяПреобразования <> Неопределено Тогда
			Результат = Неопределено;
			Выполнить("Результат = " + ИмяПреобразования + "(ИсходноеЗнч, Параметры);");
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Если Параметры <> Неопределено Тогда
		ВызватьИсключение "Параметры поддерживаются только для сложных преобразований";
	КонецЕсли;

	Попытка
		Результат = ОписаниеРезультата.ПривестиЗначение(ИсходноеЗнч);
	Исключение
		ВызватьИсключение СтрШаблон(
			"Значение типа %1 невозможно преобразовать в %2",
			ТипЗнч(ИсходноеЗнч),
			ТипРезультата
		);
	КонецПопытки;

	Если НЕ ОписаниеРезультата.СодержитТип(ТипЗнч(Результат)) Тогда
		ВызватьИсключение СтрШаблон(
			"Значение типа %1 невозможно преобразовать в %2",
			ТипЗнч(ИсходноеЗнч),
			ТипРезультата
		);
	КонецЕсли;

	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Объединить

// Добавляет содержимое Источника в изменяемый Приемник.
// Конкретная операция выбирается по типу приемника.
//
// Поддерживаемые пары:
//  * Массив <- Массив, ФиксированныйМассив;
//  * Структура <- Структура, ФиксированнаяСтруктура;
//  * Соответствие <- Структура, ФиксированнаяСтруктура,
//                    Соответствие, ФиксированноеСоответствие;
//  * СписокЗначений <- СписокЗначений;
//  * ТаблицаЗначений <- ТаблицаЗначений;
//  * ДеревоЗначений <- ДеревоЗначений.
//
// Для структур и соответствий совпадающий ключ по умолчанию получает значение Источника.
// Для таблиц и деревьев недостающие колонки по умолчанию добавляются автоматически.
//
// Параметры:
//  Приемник - изменяемая поддерживаемая коллекция.
//  Источник - совместимая коллекция-источник.
//  Параметры - Неопределено, Структура, ФиксированнаяСтруктура - настройки конкретной специализации:
//      * Массив: ТолькоУникальные - Булево, по умолчанию Ложь;
//      * Структура, Соответствие: ПерезаписыватьСуществующие - Булево, по умолчанию Истина;
//      * СписокЗначений: ТолькоУникальные - Булево, по умолчанию Ложь;
//      * ТаблицаЗначений, ДеревоЗначений: ДобавлятьНедостающиеКолонки - Булево,
//        по умолчанию Истина.
&НаСервере
Процедура Объединить(Приемник, Источник, Параметры = Неопределено) Экспорт
	ТипПриемника = ТипЗнч(Приемник);

	// При добавлении нового поддерживаемого типа достаточно зарегистрировать его здесь
	// и создать Объединить<Суффикс>(); диспетчер при этом не разрастается ветвлениями.
	СуффиксыПоТипам = Новый Соответствие;
	СуффиксыПоТипам.Вставить(Тип("Массив"), "Массивы");
	СуффиксыПоТипам.Вставить(Тип("Структура"), "Структуры");
	СуффиксыПоТипам.Вставить(Тип("Соответствие"), "Соответствия");
	СуффиксыПоТипам.Вставить(Тип("СписокЗначений"), "СпискиЗначений");
	СуффиксыПоТипам.Вставить(Тип("ТаблицаЗначений"), "ТаблицыЗначений");
	СуффиксыПоТипам.Вставить(Тип("ДеревоЗначений"), "ДеревьяЗначений");

	Суффикс = СуффиксыПоТипам.Получить(ТипПриемника);
	// Например, если сюда передадут ФиксированныйМассив как приемник, специализации
	// для него нет: лучше вернуть понятную ошибку здесь, чем ошибку динамического вызова.
	Если НЕ ЗначениеЗаполнено(Суффикс) Тогда
		ВызватьИсключение СтрШаблон("Неподдерживаемый тип приемника для объединения: %1", ТипПриемника);
	КонецЕсли;

	Выполнить("Объединить" + Суффикс + "(Приемник, Источник, Параметры);");
КонецПроцедуры

#КонецОбласти

#Область ТаблицыЗначений

// Создает таблицу значений с указанными колонками.
//
// Параметры:
//  Колонки - не заполнено - возвращается таблица без колонок.
//          - Строка - имена колонок через запятую.
//          - Массив, ФиксированныйМассив - имена колонок.
//          - Структура, ФиксированнаяСтруктура, Соответствие,
//            ФиксированноеСоответствие - ключ является именем колонки,
//            значение - ОписаниеТипов или Неопределено.
//          - ТаблицаЗначений - структура колонок копируется из таблицы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - новая пустая таблица.
&НаСервере
Функция СоздатьТаблицуЗначений(Колонки = Неопределено) Экспорт
	Таблица = Новый ТаблицаЗначений;
	Если НЕ ЗначениеЗаполнено(Колонки) Тогда Возврат Таблица; КонецЕсли;

	ДобавитьКолонки(Таблица, Колонки);
	Возврат Таблица;
КонецФункции

// Добавляет в таблицу отсутствующие колонки.
// Уже существующие колонки не изменяются.
//
// Параметры:
//  Таблица - ТаблицаЗначений - изменяемая таблица.
//  Колонки - см. СоздатьТаблицуЗначений.Колонки.
&НаСервере
Процедура ДобавитьКолонки(Таблица, Колонки) Экспорт
	ПроверитьТаблицуЗначений(Таблица, "Таблица");
	Если НЕ ЗначениеЗаполнено(Колонки) Тогда Возврат; КонецЕсли;

	ТипКолонок = ТипЗнч(Колонки);
	ЭтоТаблицаЗначений = ТипКолонок = Тип("ТаблицаЗначений");
	КолонкиКлючЗначение = ЭтоКоллекцияКлючЗначение(Колонки);
	КолонкиСписок = SharedToolkit_Значения.ЗначениеОдногоИзТипов(Колонки, "Массив,ФиксированныйМассив");

	Если ЭтоТаблицаЗначений Тогда
		ЭлементыКолонок = Колонки.Колонки;
	ИначеЕсли КолонкиКлючЗначение ИЛИ КолонкиСписок Тогда
		ЭлементыКолонок = Колонки;
	ИначеЕсли ТипКолонок = Тип("Строка") Тогда
		ЭлементыКолонок = СтрРазделить(Колонки, ",", Ложь);
	Иначе
		ВызватьИсключение СтрШаблон("Неподдерживаемое описание колонок: %1", ТипКолонок);
	КонецЕсли;

	// Когда Колонки переданы строкой или массивом имен, тип для них вообще не задан.
	// Пустое ОписаниеТипов сохраняет такие колонки нетипизированными и позволяет
	// использовать тот же единый вызов Колонки.Добавить(...), что и для таблицы-образца.
	ПустойНаборТипов = Новый Массив;
	ТипЛюбогоЗначения = Новый ОписаниеТипов(ПустойНаборТипов);

	Для Каждого ЭлементКолонки Из ЭлементыКолонок Цикл
		ТипКолонки = ТипЛюбогоЗначения;
		ЗаголовокКолонки = "";
		ШиринаКолонки = 0;

		Если ЭтоТаблицаЗначений Тогда
			ИмяКолонки = ЭлементКолонки.Имя;
			ТипКолонки = ЭлементКолонки.ТипЗначения;
			ЗаголовокКолонки = ЭлементКолонки.Заголовок;
			ШиринаКолонки = ЭлементКолонки.Ширина;
		ИначеЕсли КолонкиКлючЗначение Тогда
			ИмяКолонки = ЭлементКолонки.Ключ;
			// Например, Структура("Цена", Неопределено) означает колонку без ограничения типа,
			// а Структура("Цена", Новый ОписаниеТипов("Число")) — типизированную колонку.
			Если НЕ SharedToolkit_Значения.ЗначениеОдногоИзТипов(ЭлементКолонки.Значение, "ОписаниеТипов,Неопределено") Тогда
				ВызватьИсключение СтрШаблон("Описание колонки %1 должно иметь тип ОписаниеТипов или Неопределено", ИмяКолонки);
			КонецЕсли;
			Если ТипЗнч(ЭлементКолонки.Значение) = Тип("ОписаниеТипов") Тогда ТипКолонки = ЭлементКолонки.Значение; КонецЕсли;
		Иначе
			ИмяКолонки = ЭлементКолонки;
		КонецЕсли;

		// Если в массиве или соответствии имя задано, например, числом 2026,
		// используем колонку "2026" вместо отказа только из-за исходного типа значения.
		ИмяКолонки = СокрЛП(Строка(ИмяКолонки));
		Если НЕ ЗначениеЗаполнено(ИмяКолонки) Тогда Продолжить; КонецЕсли;
		// При последовательном объединении схем одна и та же колонка может встретиться
		// несколько раз; первое уже принятое описание колонки сохраняем без перезаписи.
		Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда Продолжить; КонецЕсли;

		Таблица.Колонки.Добавить(ИмяКолонки, ТипКолонки, ЗаголовокКолонки, ШиринаКолонки);
	КонецЦикла;
КонецПроцедуры

// Фильтрует колонки таблицы по набору имен или динамическому условию.
// Порядок оставшихся колонок не изменяется.
//
// Параметры:
//  Таблица - ТаблицаЗначений - изменяемая таблица.
//  Фильтр - Строка - выражение встроенного языка, возвращающее Булево.
//      В выражении доступны переменные Колонка, Таблица и Параметры.
//      Например: "СтрНачинаетсяС(Колонка.Имя, Параметры.Префикс)".
//      Строка исполняется как код BSL и должна быть доверенным выражением,
//      заданным разработчиком. Не передавайте сюда пользовательский ввод,
//      данные базы, настройки, HTTP-ответы или другой внешний текст.
//           - Массив, ФиксированныйМассив - имена колонок.
//           - Структура, ФиксированнаяСтруктура, Соответствие,
//             ФиксированноеСоответствие - имена колонок берутся из ключей.
//           - ТаблицаЗначений - имена колонок берутся из схемы таблицы-образца.
//  ОставлятьСовпавшие - Булево - Истина оставляет совпавшие колонки,
//      Ложь удаляет совпавшие колонки.
//  Параметры - Произвольный - дополнительный контекст для строкового выражения.
&НаСервере
Процедура ФильтроватьКолонки(Таблица, Фильтр, ОставлятьСовпавшие = Истина, Параметры = Неопределено) Экспорт
	ПроверитьТаблицуЗначений(Таблица, "Таблица");

	// Вызов ФильтроватьКолонки(Таблица, "Колонка.Ширина > 10") должен выполнять
	// выражение, поэтому строка здесь трактуется как код, а не как имя одной колонки.
	ФильтрПоКоду = ТипЗнч(Фильтр) = Тип("Строка");
	Если ФильтрПоКоду И НЕ ЗначениеЗаполнено(Фильтр) Тогда ВызватьИсключение "Условие фильтра колонок не заполнено"; КонецЕсли;

	ИменаКолонок = Новый Соответствие;
	Если НЕ ФильтрПоКоду Тогда
		Для Каждого ИмяКолонки Из ПолучитьИменаКолонок(Фильтр) Цикл
			ИменаКолонок.Вставить(ИмяКолонки, Истина);
		КонецЦикла;
	КонецЕсли;

	УдаляемыеКолонки = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если ФильтрПоКоду Тогда
			// Пользовательское выражение может случайно вернуть, например, Колонка.Имя вместо
			// условия. В таком случае прекращаем обработку здесь, а не используем строку как флаг.
			Подходит = Ложь;
			Выполнить("Подходит = (" + Фильтр + ");");
			Если ТипЗнч(Подходит) <> Тип("Булево") Тогда ВызватьИсключение "Условие фильтра колонок должно возвращать Булево"; КонецЕсли;
		Иначе
			Подходит = Содержит(ИменаКолонок, Колонка.Имя);
		КонецЕсли;

		Если Подходит = ОставлятьСовпавшие Тогда Продолжить; КонецЕсли;
		УдаляемыеКолонки.Добавить(Колонка.Имя);
	КонецЦикла;

	Для Каждого ИмяКолонки Из УдаляемыеКолонки Цикл
		Таблица.Колонки.Удалить(Таблица.Колонки[ИмяКолонки]);
	КонецЦикла;
КонецПроцедуры

// Удаляет из таблицы указанные колонки.
// Является семантической оберткой над ФильтроватьКолонки().
//
// Параметры:
//  Таблица - ТаблицаЗначений - изменяемая таблица.
//  Колонки - Строка - имена колонок через запятую.
//          - Массив, ФиксированныйМассив - имена колонок.
//          - Структура, ФиксированнаяСтруктура, Соответствие,
//            ФиксированноеСоответствие - имена колонок берутся из ключей.
//          - ТаблицаЗначений - имена колонок берутся из схемы таблицы-образца.
&НаСервере
Процедура УдалитьКолонки(Таблица, Колонки) Экспорт
	ФильтроватьКолонки(Таблица, ПолучитьИменаКолонок(Колонки), Ложь);
КонецПроцедуры

// Оставляет в таблице только указанные колонки.
// Является семантической оберткой над ФильтроватьКолонки().
//
// Параметры:
//  Таблица - ТаблицаЗначений - изменяемая таблица.
//  Колонки - Строка - имена колонок через запятую.
//          - Массив, ФиксированныйМассив - имена колонок.
//          - Структура, ФиксированнаяСтруктура, Соответствие,
//            ФиксированноеСоответствие - имена колонок берутся из ключей.
//          - ТаблицаЗначений - имена колонок берутся из схемы таблицы-образца.
&НаСервере
Процедура ОставитьКолонки(Таблица, Колонки) Экспорт
	ФильтроватьКолонки(Таблица, ПолучитьИменаКолонок(Колонки), Истина);
КонецПроцедуры

// Переименовывает несколько колонок за один вызов.
//
// Параметры:
//  Таблица - ТаблицаЗначений - изменяемая таблица.
//  СоответствиеИмен - Структура, ФиксированнаяСтруктура, Соответствие,
//                     ФиксированноеСоответствие - старое имя -> новое имя.
&НаСервере
Процедура ПереименоватьКолонки(Таблица, СоответствиеИмен) Экспорт
	ПроверитьТаблицуЗначений(Таблица, "Таблица");
	Если НЕ ЭтоКоллекцияКлючЗначение(СоответствиеИмен) Тогда ВызватьИсключение СтрШаблон("Ожидалось соответствие имен колонок, получен %1", ТипЗнч(СоответствиеИмен)); КонецЕсли;

	Для Каждого КлючЗначение Из СоответствиеИмен Цикл
		СтароеИмя = КлючЗначение.Ключ;
		НовоеИмя = КлючЗначение.Значение;
		Если ТипЗнч(СтароеИмя) <> Тип("Строка") ИЛИ ТипЗнч(НовоеИмя) <> Тип("Строка") Тогда ВызватьИсключение "Имена колонок должны быть строками"; КонецЕсли;

		СтароеИмя = СокрЛП(СтароеИмя);
		НовоеИмя = СокрЛП(НовоеИмя);
		Если НЕ ЗначениеЗаполнено(СтароеИмя) ИЛИ НЕ ЗначениеЗаполнено(НовоеИмя) Тогда ВызватьИсключение "Имя колонки не заполнено"; КонецЕсли;

		Колонка = Таблица.Колонки.Найти(СтароеИмя);
		// Одна карта переименований может применяться к таблицам с немного разной схемой;
		// если конкретной старой колонки в этой таблице нет, остальные переименования продолжаются.
		Если Колонка = Неопределено Тогда Продолжить; КонецЕсли;
		Если СтароеИмя <> НовоеИмя И Таблица.Колонки.Найти(НовоеИмя) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон("Колонка с именем %1 уже существует", НовоеИмя);
		КонецЕсли;
		Колонка.Имя = НовоеИмя;
	КонецЦикла;
КонецПроцедуры

// Удаляет строки, соответствующие отбору ТаблицаЗначений.НайтиСтроки().
//
// Параметры:
//  Таблица - ТаблицаЗначений - изменяемая таблица.
//  Отбор - Структура - значения колонок, которым должны соответствовать удаляемые строки.
&НаСервере
Процедура УдалитьСтроки(Таблица, Отбор) Экспорт
	ПроверитьТаблицуЗначений(Таблица, "Таблица");
	НайденныеСтроки = Таблица.НайтиСтроки(Отбор);
	Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
		Таблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Преобразование

Функция ПолучитьОписаниеТиповРезультата(ТипРезультата)
	Если ТипЗнч(ТипРезультата) = Тип("ОписаниеТипов") Тогда Возврат ТипРезультата; КонецЕсли;
	Если ТипЗнч(ТипРезультата) <> Тип("Тип") Тогда ВызватьИсключение "Тип результата должен иметь тип Тип или ОписаниеТипов"; КонецЕсли;

	Типы = Новый Массив;
	Типы.Добавить(ТипРезультата);
	Возврат Новый ОписаниеТипов(Типы);
КонецФункции

Функция ПолучитьИмяСложногоПреобразования(ТипИсточника, ТипРезультата)
	ПреобразованияПоТипам = Новый Соответствие;

#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда
	МассивВТаблицу = Новый Соответствие;
	МассивВТаблицу.Вставить(Тип("ТаблицаЗначений"), "ПреобразоватьМассивВТаблицуЗначений");
	ПреобразованияПоТипам.Вставить(Тип("Массив"), МассивВТаблицу);
	ПреобразованияПоТипам.Вставить(Тип("ФиксированныйМассив"), МассивВТаблицу);

	КоллекцияКлючЗнчВТаблицу = Новый Соответствие;
	КоллекцияКлючЗнчВТаблицу.Вставить(Тип("ТаблицаЗначений"), "ПреобразоватьКоллекциюКлючЗнчВТаблицуЗначений");
	ПреобразованияПоТипам.Вставить(Тип("Структура"), КоллекцияКлючЗнчВТаблицу);
	ПреобразованияПоТипам.Вставить(Тип("ФиксированнаяСтруктура"), КоллекцияКлючЗнчВТаблицу);
	ПреобразованияПоТипам.Вставить(Тип("Соответствие"), КоллекцияКлючЗнчВТаблицу);
	ПреобразованияПоТипам.Вставить(Тип("ФиксированноеСоответствие"), КоллекцияКлючЗнчВТаблицу);

	ТаблицаВМассив = Новый Соответствие;
	ТаблицаВМассив.Вставить(Тип("Массив"), "ПреобразоватьТаблицуЗначенийВМассив");
	ПреобразованияПоТипам.Вставить(Тип("ТаблицаЗначений"), ТаблицаВМассив);
#КонецЕсли

	ПреобразованияИсточника = ПреобразованияПоТипам.Получить(ТипИсточника);
	Если ПреобразованияИсточника = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Возврат ПреобразованияИсточника.Получить(ТипРезультата);
КонецФункции

#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда
Функция ПреобразоватьМассивВТаблицуЗначений(ИсходноеЗнч, Параметры)
	Если Параметры <> Неопределено Тогда ВызватьИсключение "Преобразование массива в таблицу значений не принимает параметры"; КонецЕсли;

	Таблица = Новый ТаблицаЗначений;
	// Поля могут впервые встретиться в последнем элементе массива, поэтому сначала
	// собирается схема по всем структурам и только затем создаются строки таблицы.
	Для Каждого СтруктураСтроки Из ИсходноеЗнч Цикл
		Если НЕ SharedToolkit_Значения.ЗначениеОдногоИзТипов(СтруктураСтроки, "Структура,ФиксированнаяСтруктура") Тогда
			ВызватьИсключение СтрШаблон("Элемент массива должен быть структурой, получен %1", ТипЗнч(СтруктураСтроки));
		КонецЕсли;
		ДобавитьКолонки(Таблица, ПолучитьИменаКолонок(СтруктураСтроки));
	КонецЦикла;

	Для Каждого СтруктураСтроки Из ИсходноеЗнч Цикл
		СтрокаТаблицы = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураСтроки);
	КонецЦикла;

	Возврат Таблица;
КонецФункции

Функция ПреобразоватьКоллекциюКлючЗнчВТаблицуЗначений(ИсходноеЗнч, Параметры)
	ИмяКолонкиКлюча = ПолучитьИзКоллекции(Параметры, "ИмяКолонкиКлюча", "Ключ", Тип("Строка"));
	ИмяКолонкиЗнч = ПолучитьИзКоллекции(Параметры, "ИмяКолонкиЗнч", "Значение", Тип("Строка"));
	Если НЕ ЗначениеЗаполнено(ИмяКолонкиКлюча) Тогда ВызватьИсключение "Имя колонки ключа не заполнено"; КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ИмяКолонкиЗнч) Тогда ВызватьИсключение "Имя колонки значения не заполнено"; КонецЕсли;
	Если ИмяКолонкиКлюча = ИмяКолонкиЗнч Тогда ВызватьИсключение "Имена колонок ключа и значения должны различаться"; КонецЕсли;

	Таблица = СоздатьТаблицуЗначений(ИмяКолонкиКлюча + "," + ИмяКолонкиЗнч);
	Для Каждого КлючЗнч Из ИсходноеЗнч Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы[ИмяКолонкиКлюча] = КлючЗнч.Ключ;
		СтрокаТаблицы[ИмяКолонкиЗнч] = КлючЗнч.Значение;
	КонецЦикла;

	Возврат Таблица;
КонецФункции

Функция ПреобразоватьТаблицуЗначенийВМассив(ИсходноеЗнч, Параметры)
	Если Параметры <> Неопределено Тогда ВызватьИсключение "Преобразование таблицы значений в массив не принимает параметры"; КонецЕсли;

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из ИсходноеЗнч Цикл
		СтруктураСтроки = Новый Структура;
		Для Каждого Колонка Из ИсходноеЗнч.Колонки Цикл
			СтруктураСтроки.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
		КонецЦикла;
		Результат.Добавить(СтруктураСтроки);
	КонецЦикла;

	Возврат Результат;
КонецФункции
#КонецЕсли

#КонецОбласти

#Область Содержит

Функция СодержитВМассиве(Коллекция, Элемент, РежимПоиска)
	Возврат Коллекция.Найти(Элемент) <> Неопределено;
КонецФункции

Функция СодержитВСтруктуре(Коллекция, Элемент, РежимПоиска)
	Если РежимПоиска = Неопределено ИЛИ РежимПоиска = "Ключ" Тогда Возврат Коллекция.Свойство(Строка(Элемент)); КонецЕсли;
	Если РежимПоиска <> "Знч" Тогда ВызватьИсключение "Режим поиска должен быть 'Ключ' или 'Знч'"; КонецЕсли;

	Для Каждого КлючЗнч Из Коллекция Цикл
		Если КлючЗнч.Значение = Элемент Тогда Возврат Истина; КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СодержитВСоответствии(Коллекция, Элемент, РежимПоиска)
	Если РежимПоиска = "Знч" Тогда
		Для Каждого КлючЗнч Из Коллекция Цикл
			Если КлючЗнч.Значение = Элемент Тогда Возврат Истина; КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;
	Если РежимПоиска <> Неопределено И РежимПоиска <> "Ключ" Тогда ВызватьИсключение "Режим поиска должен быть 'Ключ' или 'Знч'"; КонецЕсли;

	// Ключ может существовать со значением Неопределено, поэтому результат Получить()
	// в этой ситуации нельзя отличить от отсутствующего ключа.
	Для Каждого КлючЗнч Из Коллекция Цикл
		Если КлючЗнч.Ключ = Элемент Тогда Возврат Истина; КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СодержитВСпискеЗначений(Коллекция, Элемент, РежимПоиска)
	Возврат Коллекция.НайтиПоЗначению(Элемент) <> Неопределено;
КонецФункции

#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда
Функция СодержитВТаблицеЗначений(Коллекция, Элемент, РежимПоиска)
	Если ТипЗнч(Элемент) <> Тип("СтрокаТаблицыЗначений") Тогда Возврат Ложь; КонецЕсли;
	Возврат Коллекция.Индекс(Элемент) >= 0;
КонецФункции

Функция СодержитВДеревеЗначений(Коллекция, Элемент, РежимПоиска)
	Если ТипЗнч(Элемент) <> Тип("СтрокаДереваЗначений") Тогда Возврат Ложь; КонецЕсли;
	Возврат СодержатСтрокиДерева(Коллекция.Строки, Элемент);
КонецФункции

Функция СодержатСтрокиДерева(Строки, Элемент)
	Если Строки.Индекс(Элемент) >= 0 Тогда Возврат Истина; КонецЕсли;

	Для Каждого Строка Из Строки Цикл
		Если СодержатСтрокиДерева(Строка.Строки, Элемент) Тогда Возврат Истина; КонецЕсли;
	КонецЦикла;

	Возврат Ложь;
КонецФункции
#КонецЕсли

#КонецОбласти

#Область Объединить

Процедура ОбъединитьМассивы(Приемник, Источник, Параметры)
	Если НЕ SharedToolkit_Значения.ЗначениеОдногоИзТипов(Источник, "Массив,ФиксированныйМассив") Тогда
		ВызватьИсключение СтрШаблон("Массив можно объединить только с массивом, получен %1", ТипЗнч(Источник));
	КонецЕсли;
	ТолькоУникальные = ПолучитьИзКоллекции(Параметры, "ТолькоУникальные", Ложь, Тип("Булево"));

	КоличествоИсходныхЭлементов = Источник.Количество();
	Для Индекс = 0 По КоличествоИсходныхЭлементов - 1 Цикл
		Значение = Источник.Получить(Индекс);
		Если ТолькоУникальные И Содержит(Приемник, Значение) Тогда Продолжить; КонецЕсли;
		Приемник.Добавить(Значение);
	КонецЦикла;
КонецПроцедуры

Процедура ОбъединитьСтруктуры(Приемник, Источник, Параметры)
	Если НЕ SharedToolkit_Значения.ЗначениеОдногоИзТипов(Источник, "Структура,ФиксированнаяСтруктура") Тогда
		ВызватьИсключение СтрШаблон("Структуру можно объединить только со структурой, получен %1", ТипЗнч(Источник));
	КонецЕсли;
	Перезаписывать = ПолучитьИзКоллекции(Параметры, "ПерезаписыватьСуществующие", Истина, Тип("Булево"));

	Для Каждого КлючЗначение Из Источник Цикл
		Если НЕ Перезаписывать И Содержит(Приемник, КлючЗначение.Ключ) Тогда Продолжить; КонецЕсли;
		Приемник.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
КонецПроцедуры

Процедура ОбъединитьСоответствия(Приемник, Источник, Параметры)
	Если НЕ ЭтоКоллекцияКлючЗначение(Источник) Тогда
		ВызватьИсключение СтрШаблон("Соответствие можно объединить только с коллекцией ключ-значение, получен %1", ТипЗнч(Источник));
	КонецЕсли;
	Перезаписывать = ПолучитьИзКоллекции(Параметры, "ПерезаписыватьСуществующие", Истина, Тип("Булево"));

	Для Каждого КлючЗначение Из Источник Цикл
		Если НЕ Перезаписывать И Содержит(Приемник, КлючЗначение.Ключ) Тогда Продолжить; КонецЕсли;
		Приемник.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
КонецПроцедуры

Процедура ОбъединитьСпискиЗначений(Приемник, Источник, Параметры)
	Если ТипЗнч(Источник) <> Тип("СписокЗначений") Тогда
		ВызватьИсключение СтрШаблон("Список значений можно объединить только со списком значений, получен %1", ТипЗнч(Источник));
	КонецЕсли;
	ТолькоУникальные = ПолучитьИзКоллекции(Параметры, "ТолькоУникальные", Ложь, Тип("Булево"));

	КоличествоИсходныхЭлементов = Источник.Количество();
	Для Индекс = 0 По КоличествоИсходныхЭлементов - 1 Цикл
		Элемент = Источник.Получить(Индекс);
		Если ТолькоУникальные И Содержит(Приемник, Элемент.Значение) Тогда Продолжить; КонецЕсли;
		Приемник.Добавить(Элемент.Значение, Элемент.Представление, Элемент.Пометка, Элемент.Картинка);
	КонецЦикла;
КонецПроцедуры

Процедура ОбъединитьТаблицыЗначений(Приемник, Источник, Параметры)
	ПроверитьТаблицуЗначений(Источник, "Источник");
	ДобавлятьКолонки = ПолучитьИзКоллекции(Параметры, "ДобавлятьНедостающиеКолонки", Истина, Тип("Булево"));
	Если ДобавлятьКолонки Тогда ДобавитьКолонки(Приемник, Источник); КонецЕсли;

	КоличествоИсходныхСтрок = Источник.Количество();
	Для Индекс = 0 По КоличествоИсходныхСтрок - 1 Цикл
		СтрокаПриемника = Приемник.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПриемника, Источник.Получить(Индекс));
	КонецЦикла;
КонецПроцедуры

Процедура ОбъединитьДеревьяЗначений(Приемник, Источник, Параметры)
	Если ТипЗнч(Источник) <> Тип("ДеревоЗначений") Тогда
		ВызватьИсключение СтрШаблон("Дерево значений можно объединить только с деревом значений, получен %1", ТипЗнч(Источник));
	КонецЕсли;
	ДобавлятьКолонки = ПолучитьИзКоллекции(Параметры, "ДобавлятьНедостающиеКолонки", Истина, Тип("Булево"));
	Если ДобавлятьКолонки Тогда ДобавитьКолонкиДерева(Приемник, Источник); КонецЕсли;

	КоличествоИсходныхСтрок = Источник.Строки.Количество();
	Для Индекс = 0 По КоличествоИсходныхСтрок - 1 Цикл
		ДобавитьСтрокуДерева(Приемник.Строки, Источник.Строки.Получить(Индекс));
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьКолонкиДерева(Приемник, Источник)
	Для Каждого Колонка Из Источник.Колонки Цикл
		Если Приемник.Колонки.Найти(Колонка.Имя) <> Неопределено Тогда Продолжить; КонецЕсли;
		Приемник.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьСтрокуДерева(СтрокиПриемника, СтрокаИсточника)
	СтрокаПриемника = СтрокиПриемника.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаПриемника, СтрокаИсточника);

	// У строки дерева могут быть дочерние строки любой глубины; копирование только
	// корневого уровня потеряло бы подчиненные узлы, поэтому продолжаем рекурсивно.
	Для Каждого ДочерняяСтрока Из СтрокаИсточника.Строки Цикл
		ДобавитьСтрокуДерева(СтрокаПриемника.Строки, ДочерняяСтрока);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ТаблицыЗначений

Процедура ПроверитьТаблицуЗначений(Таблица, ИмяПараметра)
	Если ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда Возврат; КонецЕсли;
	ВызватьИсключение СтрШаблон("Параметр %1 должен иметь тип ТаблицаЗначений, получен %2", ИмяПараметра, ТипЗнч(Таблица));
КонецПроцедуры

Функция ПолучитьИменаКолонок(Колонки)
	Результат = Новый Массив;
	ТипКолонок = ТипЗнч(Колонки);

	Если ТипКолонок = Тип("Строка") Тогда
		Для Каждого ИмяКолонки Из СтрРазделить(Колонки, ",", Ложь) Цикл
			ИмяКолонки = СокрЛП(ИмяКолонки);
			Если НЕ ЗначениеЗаполнено(ИмяКолонки) Тогда Продолжить; КонецЕсли;
			Результат.Добавить(ИмяКолонки);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если SharedToolkit_Значения.ЗначениеОдногоИзТипов(Колонки, "Массив,ФиксированныйМассив") Тогда
		Для Каждого ИмяКолонки Из Колонки Цикл
			Если ТипЗнч(ИмяКолонки) <> Тип("Строка") Тогда ВызватьИсключение СтрШаблон("Имя колонки должно быть строкой, получен %1", ТипЗнч(ИмяКолонки)); КонецЕсли;
			ИмяКолонки = СокрЛП(ИмяКолонки);
			Если НЕ ЗначениеЗаполнено(ИмяКолонки) Тогда Продолжить; КонецЕсли;
			Результат.Добавить(ИмяКолонки);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипКолонок = Тип("ТаблицаЗначений") Тогда
		Для Каждого Колонка Из Колонки.Колонки Цикл
			Результат.Добавить(Колонка.Имя);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ЭтоКоллекцияКлючЗначение(Колонки) Тогда
		Для Каждого КлючЗначение Из Колонки Цикл
			Если ТипЗнч(КлючЗначение.Ключ) <> Тип("Строка") Тогда ВызватьИсключение СтрШаблон("Имя колонки должно быть строкой, получен %1", ТипЗнч(КлючЗначение.Ключ)); КонецЕсли;
			Результат.Добавить(КлючЗначение.Ключ);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Неподдерживаемое описание колонок: %1", ТипКолонок);
КонецФункции

Функция ЭтоКоллекцияКлючЗначение(Коллекция)
	Возврат SharedToolkit_Значения.ЗначениеОдногоИзТипов(
		Коллекция,
		"Структура,ФиксированнаяСтруктура,Соответствие,ФиксированноеСоответствие"
	);
КонецФункции

#КонецОбласти

#КонецОбласти
