#Область ПрограммныйИнтерфейс

// Источники HyperSnips: ВыполнитьPython, ЗаполнитьПоСтрокеТЧ.

// Запускает доверенный сценарий Python на сервере и возвращает его стандартный вывод.
// Путь к исполняемому файлу и путь к сценарию должны задаваться разработчиком или
// администратором. Не передавайте сюда пути из пользовательского ввода, базы,
// хранилища настроек или внешнего запроса: эта функция запускает код ОС от имени сервера.
// Параметры сценария преобразуются в строки и передаются запущенной программе;
// их смысл и безопасность проверяет сам сценарий.
//
// Параметры:
//  ПутьКPython - Строка - доверенное имя или путь исполняемого файла Python.
//  ПутьКСкрипту - Строка - путь к доверенному сценарию Python.
//  ПараметрыСкрипта - Неопределено, Массив или значение, преобразуемое в строку.
//
// Возвращаемое значение:
//  Строка - стандартный вывод сценария.
//
// Исключения:
//  Пустые или нестроковые пути; ошибка запуска или ненулевой код завершения.
//
&НаСервере
Функция ВыполнитьPython(ПутьКPython, ПутьКСкрипту, ПараметрыСкрипта = Неопределено) Экспорт
	Если ТипЗнч(ПутьКPython) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(ПутьКPython) Тогда
		ВызватьИсключение "ПутьКPython должен быть непустой строкой доверенного исполняемого файла";
	КонецЕсли;
	Если ТипЗнч(ПутьКСкрипту) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(ПутьКСкрипту) Тогда
		ВызватьИсключение "ПутьКСкрипту должен быть непустой строкой доверенного сценария";
	КонецЕсли;

	ПараметрыЗапуска = ФайловаяСистема.ПараметрыЗапускаПрограммы();
	ПараметрыЗапуска.ДождатьсяЗавершения = Истина;
	ПараметрыЗапуска.ПолучитьПотокВывода = Истина;
	ПараметрыЗапуска.ПолучитьПотокОшибок = Истина;
	ПараметрыЗапуска.КодировкаПотоков = "UTF8";
	ПараметрыЗапуска.КодировкаИсполнения = "UTF8";

	Команда = Новый Массив;
	Команда.Добавить(ПутьКPython);
	Команда.Добавить("-X");
	Команда.Добавить("utf8");
	Команда.Добавить(ПутьКСкрипту);
	Если ЗначениеЗаполнено(ПараметрыСкрипта) Тогда
		Если ТипЗнч(ПараметрыСкрипта) = Тип("Массив") Тогда
			Для Каждого Параметр Из ПараметрыСкрипта Цикл
				Команда.Добавить(Строка(Параметр));
			КонецЦикла;
		Иначе
			Команда.Добавить(Строка(ПараметрыСкрипта));
		КонецЕсли;
	КонецЕсли;

	Результат = ФайловаяСистема.ЗапуститьПрограмму(Команда, ПараметрыЗапуска);
	Если Результат.КодВозврата <> 0 Тогда
		ВызватьИсключение Результат.ПотокОшибок;
	КонецЕсли;
	Возврат Результат.ПотокВывода;
КонецФункции

Процедура ЗаполнитьСтрокуXBaseИзСпискаДанных(СтрокаXBase, СтрокаДанных) Экспорт
	Для Каждого ПолеXBase Из СтрокаXBase.Поля Цикл
		ИмяПоля = ПолеXBase.Имя;
		Попытка
			ЗначениеПоля = СтрокаДанных[ИмяПоля];
			Если ТипЗнч(ЗначениеПоля) = Тип("Строка") Тогда
				ЗначениеПоля = СокрЛП(ЗначениеПоля);
			КонецЕсли;
			СтрокаXBase[ИмяПоля] = ЗначениеПоля;
		Исключение
			SharedToolkit_ЖурналРегистрации.ЗаписатьОшибку(
				"SharedToolkit.XBase.ЗаполнениеПоля." + ИмяПоля,
				ИнформацияОбОшибке()
			);
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
