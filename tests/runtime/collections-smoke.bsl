Сообщить("SharedToolkit collections smoke: start");

Массив = Новый Массив;
Массив.Добавить("Первый");
Массив.Добавить("Второй");
Если НЕ SharedToolkit_Коллекции.Содержит(Массив, "Первый") Тогда
	ВызватьИсключение "Содержит(): существующее значение массива не найдено";
КонецЕсли;
Если SharedToolkit_Коллекции.Содержит(Массив, "Третий") Тогда
	ВызватьИсключение "Содержит(): отсутствующее значение массива найдено";
КонецЕсли;

Структура = Новый Структура;
Структура.Вставить("Флаг", Ложь);
Структура.Вставить("Имя", "Тест");
Если НЕ SharedToolkit_Коллекции.Содержит(Структура, "Флаг") Тогда
	ВызватьИсключение "Содержит(): ключ структуры не найден";
КонецЕсли;
Если НЕ SharedToolkit_Коллекции.Содержит(Структура, Ложь, "Знч") Тогда
	ВызватьИсключение "Содержит(): значение Ложь структуры не найдено";
КонецЕсли;
Если SharedToolkit_Коллекции.ПолучитьИзКоллекции(Структура, "Флаг", Истина, Тип("Булево")) <> Ложь Тогда
	ВызватьИсключение "ПолучитьИзКоллекции(): явно заданное Ложь потеряно";
КонецЕсли;
Если SharedToolkit_Коллекции.ПолучитьИзКоллекции(Структура, "НетКлюча", "ПоУмолчанию") <> "ПоУмолчанию" Тогда
	ВызватьИсключение "ПолучитьИзКоллекции(): значение по умолчанию не возвращено";
КонецЕсли;

ОписаниеКолонок = Новый Структура;
ОписаниеКолонок.Вставить("Код", Неопределено);
ОписаниеКолонок.Вставить("Наименование", Неопределено);
ТаблицаПоОписанию = SharedToolkit_Коллекции.СоздатьТаблицуЗначений(ОписаниеКолонок);
Если ТаблицаПоОписанию.Колонки.Найти("Код") = Неопределено
	ИЛИ ТаблицаПоОписанию.Колонки.Найти("Наименование") = Неопределено Тогда
	ВызватьИсключение "СоздатьТаблицуЗначений(): колонки из структуры не созданы";
КонецЕсли;

МассивСтруктур = Новый Массив;
МассивСтруктур.Добавить(Новый Структура("Код,Имя", 1, "Первый"));
МассивСтруктур.Добавить(Новый Структура("Код,Имя,Доп", 2, "Второй", Истина));
Таблица = SharedToolkit_Коллекции.ПреобразоватьВ(МассивСтруктур, Тип("ТаблицаЗначений"));
Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
	ВызватьИсключение "ПреобразоватьВ(): массив структур не преобразован в ТаблицаЗначений";
КонецЕсли;
Если Таблица.Количество() <> 2 Тогда
	ВызватьИсключение "ПреобразоватьВ(): потеряны строки при преобразовании массива";
КонецЕсли;
Если Таблица.Колонки.Найти("Доп") = Неопределено Тогда
	ВызватьИсключение "ПреобразоватьВ(): поле позднего элемента не попало в схему таблицы";
КонецЕсли;

МассивОбратно = SharedToolkit_Коллекции.ПреобразоватьВ(Таблица, Тип("Массив"));
Если МассивОбратно.Количество() <> 2 Тогда
	ВызватьИсключение "ПреобразоватьВ(): таблица не преобразована обратно в массив";
КонецЕсли;
Если МассивОбратно[1].Код <> 2 ИЛИ МассивОбратно[1].Имя <> "Второй" Тогда
	ВызватьИсключение "ПреобразоватьВ(): значения таблицы потеряны при преобразовании в массив";
КонецЕсли;

Соответствие = Новый Соответствие;
Соответствие.Вставить("A", 10);
Соответствие.Вставить("B", 20);
ПараметрыТаблицы = Новый Структура("ИмяКолонкиКлюча,ИмяКолонкиЗнч", "Свойство", "Знч");
ТаблицаКлючЗнч = SharedToolkit_Коллекции.ПреобразоватьВ(Соответствие, Тип("ТаблицаЗначений"), ПараметрыТаблицы);
Если ТаблицаКлючЗнч.Количество() <> 2 Тогда
	ВызватьИсключение "ПреобразоватьВ(): коллекция ключ-значение потеряла строки";
КонецЕсли;
Если ТаблицаКлючЗнч.Колонки.Найти("Свойство") = Неопределено
	ИЛИ ТаблицаКлючЗнч.Колонки.Найти("Знч") = Неопределено Тогда
	ВызватьИсключение "ПреобразоватьВ(): пользовательские имена колонок не применены";
КонецЕсли;

ПриемникМассив = Новый Массив;
ПриемникМассив.Добавить(1);
ИсточникМассив = Новый Массив;
ИсточникМассив.Добавить(1);
ИсточникМассив.Добавить(2);
SharedToolkit_Коллекции.Объединить(
	ПриемникМассив,
	ИсточникМассив,
	Новый Структура("ТолькоУникальные", Истина)
);
Если ПриемникМассив.Количество() <> 2 ИЛИ НЕ SharedToolkit_Коллекции.Содержит(ПриемникМассив, 2) Тогда
	ВызватьИсключение "Объединить(): режим ТолькоУникальные для массива работает неверно";
КонецЕсли;

ПриемникСтруктура = Новый Структура("A", 1);
ИсточникСтруктура = Новый Структура("A,B", 2, 3);
SharedToolkit_Коллекции.Объединить(
	ПриемникСтруктура,
	ИсточникСтруктура,
	Новый Структура("ПерезаписыватьСуществующие", Ложь)
);
Если ПриемникСтруктура.A <> 1 ИЛИ ПриемникСтруктура.B <> 3 Тогда
	ВызватьИсключение "Объединить(): ПерезаписыватьСуществующие = Ложь работает неверно";
КонецЕсли;

Сообщить("SharedToolkit collections smoke: ok");
